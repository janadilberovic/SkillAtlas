# Kopiraj u .env i popuni. .env je u .gitignore — NIKAD ne commit-uj kredencijale.
# Neo4j Desktop: default bolt port 7687, username neo4j, password onaj koji si postavila.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

SERVER_PORT=8080

# JWT HMAC secret (min 32 chars). Generate your own; never commit the real one.
JWT_SECRET=change-me-dev-only-secret-please-rotate-0123456789
JWT_EXP_MINUTES=120

# Azure Blob Storage (profilne slike). Lokalno: Azurite iz docker-compose.
# Produkcija: connection string sa Azure Portala (Storage Account -> Access keys). NIKAD u repo.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_AVATAR_CONTAINER=avatars
AZURE_AVATAR_SAS_MINUTES=15

# VacaYAY (E3 import). Servisni HR nalog u starom sistemu — NIKAD u repo.
# Nalog mora imati stalnu lozinku: dok drži privremenu, login vraća mustChangePassword i bez tokena.
VACAYAY_BASE_URL=http://localhost:5266
VACAYAY_USER=
VACAYAY_PASSWORD=
