# Kopiraj u .env i popuni. .env je u .gitignore — NIKAD ne commit-uj kredencijale.
# Neo4j Desktop: default bolt port 7687, username neo4j, password onaj koji si postavila.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

SERVER_PORT=8080

# JWT HMAC secret (min 32 chars). Generate your own; never commit the real one.
JWT_SECRET=change-me-dev-only-secret-please-rotate-0123456789
JWT_EXP_MINUTES=120
