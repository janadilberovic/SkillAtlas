{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "frontend",
      "port": 4200
    },
    {
      "name": "backend",
      "runtimeExecutable": "mvnw.cmd",
      "runtimeArgs": [
        "-q",
        "spring-boot:run"
      ],
      "cwd": ".",
      "port": 8080,
      "url": "http://localhost:8080"
    }
  ]
}
