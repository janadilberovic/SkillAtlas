# Kopiraj u .env.prod i popuni. .env.prod je u .gitignore — NIKAD ne commit-uj kredencijale.
# Pokretanje: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

SPRING_PROFILES_ACTIVE=prod

# NEO4J_URI postavlja docker-compose.prod.yml (bolt://neo4j:7687) — ovdje ga ne treba.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

SERVER_PORT=8080

# HMAC secret, min 32 znaka. Bez njega se prod profil NE pokreće — to je namjerno.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXP_MINUTES=120

# Prvi admin na praznoj bazi. Bez ovoga nema načina da se uđe: login traži postojeću osobu, a
# kreiranje osobe traži admin token. Radi samo dok nijedan admin ne postoji.
SKILLATLAS_ADMIN_BOOTSTRAP_EMAIL=
SKILLATLAS_ADMIN_BOOTSTRAP_PASSWORD=

# Prazno je ispravno: Angular se servira iz istog jara, pa cross-origin poziva nema.
# Popuni samo ako API zove još neki frontend (zarezom odvojeno).
SECURITY_CORS_ALLOWED_ORIGINS=

# Azurite ključ za nalog "skillatlas":  openssl rand -base64 32
AZURITE_KEY=

# Mora se poklopiti sa AZURITE_KEY iznad, i BlobEndpoint mora biti JAVNO ime servera —
# taj URL otvara browser korisnika, ne backend. Oblik: http://<host>:10000/<AccountName>.
# AccountName se pojavljuje dvaput; ako se ne poklope, svaka slika vraća 403.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=skillatlas;AccountKey=<isti-kao-AZURITE_KEY>;BlobEndpoint=http://<host>:10000/skillatlas;
AZURE_AVATAR_CONTAINER=avatars
AZURE_AVATAR_SAS_MINUTES=15

# VacaYAY import (E3). Prazno = dugme Import vraća "servis nedostupan"; sve ostalo radi.
VACAYAY_BASE_URL=
VACAYAY_USER=
VACAYAY_PASSWORD=
